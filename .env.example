# Open Meteo Python MCP - Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Configuration
# Required for Chat API functionality
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Alternative AI Providers
# OPENAI_API_KEY=your_openai_api_key_here
# AZURE_OPENAI_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/

# Application Configuration
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Open Meteo MCP REST API"
API_VERSION=4.0.0

# Chat Configuration
CHAT_ENABLED=true
CHAT_MODEL=claude-3-5-sonnet-20241022
CHAT_MAX_TOKENS=4096

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=100

# CORS Configuration
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Open-Meteo API Configuration
OPENMETEO_API_BASE_URL=https://api.open-meteo.com
OPENMETEO_CACHE_ENABLED=true
OPENMETEO_CACHE_TTL_SECONDS=300

# Logging Configuration
LOG_FORMAT=json
LOG_OUTPUT=stdout
